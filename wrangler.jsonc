{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snobi",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snobi",
      // Production database (account seifwork006). Local dev uses a separate local copy.
      "database_id": "5db54b83-b744-4857-a8ca-da6567c98ae4",
      "migrations_dir": "drizzle",
    },
  ],
  // Photo storage is off until R2 is enabled on the Cloudflare account (needs a card on file).
  // To turn it on: `npx wrangler r2 bucket create snobi-images`, uncomment this, `npm run cf-typegen`,
  // then `npm run deploy`. Without it the site works and photo uploads show a clear message.
  // "r2_buckets": [
  //   {
  //     "binding": "IMAGES",
  //     "bucket_name": "snobi-images",
  //   },
  // ],
}
