{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snobi",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snobi",
      // Production database (account seifwork006). Local dev uses a separate local copy.
      "database_id": "5db54b83-b744-4857-a8ca-da6567c98ae4",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "snobi-images",
    },
  ],
}
